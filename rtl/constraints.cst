//
// Tang Nano 20K — Pin Constraints
// Target: GW2AR-LV18QN88C8/I7
//

// Clock (spdif-minimal branch) — 27 MHz crystal on FPGA package pin 4:
// factory copper, present and running on every board with no setup.
// The rPLL in top.sv multiplies it ×11/3 to ~99 MHz.
//
// The mainline clock is the MS5351 at 98.304 MHz on package pin 10 —
// but that output must be configured per board (BL616 CLI:
//   pll_clk O0=98.304M -s
// one-time, persists). Measured 2026-08-28: on the new board pin 10 is
// dead until that is done.

IO_LOC  "clk27" 4;
IO_PORT "clk27" IO_TYPE=LVCMOS33;

// IO_LOC  "sysclk" 10;                 // MS5351 — mainline clock input
// IO_PORT "sysclk" IO_TYPE=LVCMOS33;

// Reset button

IO_LOC  "rst" 87;
IO_PORT "rst" IO_TYPE=LVCMOS33;

// Status LEDs (active low — pull-up, LED on when pin driven low)

IO_LOC "led[5]" 20;
IO_PORT "led[5]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "led[4]" 19;
IO_PORT "led[4]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "led[3]" 18;
IO_PORT "led[3]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "led[2]" 17;
IO_PORT "led[2]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "led[1]" 16;
IO_PORT "led[1]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "led[0]" 15;
IO_PORT "led[0]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;

// SPI slave with register bank

IO_LOC "cs" 28;
IO_PORT "cs" IO_TYPE=LVCMOS33;
IO_LOC "sclk" 25;
IO_PORT "sclk" IO_TYPE=LVCMOS33;
IO_LOC "mosi" 26;
IO_PORT "mosi" IO_TYPE=LVCMOS33;
IO_LOC "miso" 29;
IO_PORT "miso" IO_TYPE=LVCMOS33;

// I2S audio output — not in the spdif-minimal top; restore with it.
// Pin 56 temporarily carries a mirror of the SPDIF stream instead, so
// the signal is probeable even if pin 27's path is bad on this board.

IO_LOC  "spdif_mirror" 56;
IO_PORT "spdif_mirror" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;

// IO_LOC  "i2s_bclk"  56;  // HP_BCK  — bit clock
// IO_PORT "i2s_bclk"  PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
// IO_LOC  "i2s_lrclk" 55;  // HP_WS   — word select / left-right clock
// IO_PORT "i2s_lrclk" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
// IO_LOC  "i2s_data"  54;  // HP_DIN  — serial data
// IO_PORT "i2s_data"  PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;

// SPDIF audio output

IO_LOC  "spdif_out" 27;
IO_PORT "spdif_out" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;

// Unused / Reserved — uncomment as needed

// SPI Flash (for patch storage — future)
// IO_LOC  "flash_cs_n"  60;
// IO_LOC  "flash_clk"   59;
// IO_LOC  "flash_miso"  62;
// IO_LOC  "flash_mosi"  61;

// SD Card (for sample playback — future)
// IO_LOC  "sd_clk"      83;
// IO_LOC  "sd_cmd"      82;
// IO_LOC  "sd_dat[0]"   84;
// IO_LOC  "sd_dat[1]"   85;
// IO_LOC  "sd_dat[2]"   80;
// IO_LOC  "sd_dat[3]"   81;
