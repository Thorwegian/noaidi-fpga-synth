//
// The board's real pins (constraints.cst): the system clock, the SPI link
// from the ESP32, and an LED for the folded output.

IO_LOC  "clk" 10;
IO_PORT "clk" IO_TYPE=LVCMOS33;
IO_LOC  "spi_cs_n" 28;
IO_PORT "spi_cs_n" IO_TYPE=LVCMOS33;
IO_LOC  "sclk" 25;
IO_PORT "sclk" IO_TYPE=LVCMOS33;
IO_LOC  "spi_mosi" 26;
IO_PORT "spi_mosi" IO_TYPE=LVCMOS33;
IO_LOC  "folded" 15;
IO_PORT "folded" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
