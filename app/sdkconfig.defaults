# The target: an ESP32-S3R8 module (docs/esp32s3_hw678.md) with 16 MB of
# QIO flash, both memories at 80 MHz and the CPU at 240 MHz.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# The module's 8 MB of octal PSRAM joins the heap: malloc() places a block
# there when it is larger than CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL (16 KiB)
# or the internal RAM has no room for it. The component esp_psram must be in
# the build (main/CMakeLists.txt requires it): without it the minimal build
# drops these options silently.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# One of the chip's two cores. The firmware is written for one core, where
# only one task runs at a time; whether the state its tasks share holds with
# two of them running at once has not been examined.
CONFIG_FREERTOS_UNICORE=y

# The console is on the module's CH343 USB-to-UART bridge, the socket marked
# COM: UART0 on GPIO43 and GPIO44 at 115200, the rate the ROM prints its boot
# lines at, so one setting reads the whole boot log (console.c).
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# The socket marked USB is USB-OTG's alone. The chip's USB-Serial/JTAG
# controller shares its PHY with OTG and is on after every power-on, so it is
# turned off here: with no console on it, esp_system disables its clock and
# its pad at startup (port/soc/esp32s3/clk.c). The bootloader keeps it for
# download mode; the secondary console, which ESP-IDF would put back on it,
# is off with it.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n

# BLE MIDI: NimBLE peripheral hosting the standard
# MIDI 1.0 over BLE service (03B80E5A-EDE8-4B33-A751-6CE34EC4C700).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# BLE MIDI packets ride the full ATT MTU; prefer the 4.2 maximum.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
# Bonds persist in NVS so reconnects after a reboot re-encrypt (ble_midi.c).
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# Static (non-heap) NimBLE services. The dynamic path leaves the GAP
# service defs pointing at a NULL ctx until the host allocator comes
# up - ble_svc_gap_init() then walks a NULL+4 pointer and the chip
# load-access-faults in a boot loop (seen on silicon). Static it is.
CONFIG_BT_NIMBLE_STATIC_TO_DYNAMIC=n

# 1 kHz FreeRTOS tick.
CONFIG_FREERTOS_HZ=1000

# TASK_WDT_PANIC turns the task watchdog from a warn-and-limp into a
# clean panic with the backtrace of the stuck task.
CONFIG_ESP_TASK_WDT_PANIC=y

# app_main loads the startup preset (TOML parsing) before the tasks take
# over, more than the default 3584-byte main task stack holds.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# The console's tasks command: per-task state, stack high-water mark and
# CPU share (cli_system.c).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Preset storage (docs/storage_format.md): a FAT partition on the
# wear-levelling layer, 512-byte sectors so a ~650-byte preset takes
# two sectors instead of a 4 KB one, safety mode so a power loss
# mid-write keeps the rest of the flash sector, and long UTF-8 names.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_WL_SECTOR_SIZE_512=y
CONFIG_WL_SECTOR_MODE_SAFE=y
CONFIG_FATFS_SECTOR_512=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
